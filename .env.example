# Los scripts Docker leen estas opciones como texto; el entorno prevalece.
# Copia a .env y elige una contraseña de solo letras y números.
TM_POSTGRES_PASSWORD=
TM_POSTGRES_IMAGE=postgres:16.6-bookworm
TM_IMAGE=tournament-management:step-1.5
TM_API_PORT=8000
TM_START_TIMEOUT=180
# Máximo de bytes por bot; se aplica también a las lecturas de los workers.
TM_ARTIFACT_MAX_BYTES=1048576

# Backend del coordinador: local juega en el coordinador; ray juega en los workers.
TM_BACKEND=local

# Workers del clúster Docker (5.1): tm-worker-1..N, 1 CPU y 1 partida cada uno.
# Para añadir uno con el clúster en marcha: bash scripts/add-worker.sh tm-worker-N
TM_WORKERS=4
# Tope de memoria de cada worker (no es una reserva). Medir con docker stats.
TM_WORKER_MEMORY=2g
# Límites de carga del coordinador (5.1). Vacíos: 64 intentos y 16 torneos activos.
TM_MAX_RUNNING_ATTEMPTS=
TM_MAX_ACTIVE_TOURNAMENTS=

# Opciones de la aplicación para ejecución local: hay que exportarlas manualmente.
TM_ROLE=coordinator
TM_RAY_ADDRESS=auto
TM_HTTP_HOST=127.0.0.1
TM_HTTP_PORT=8000
TM_DATA_DIR=./data
# Vacío solo para diagnóstico local. En un coordinador desplegado debe apuntar a PostgreSQL.
TM_DATABASE_URL=
TM_LOG_LEVEL=INFO
# Límites validados; se aplicarán al implementar árbitro y scheduler.
TM_TURN_TIMEOUT_MS=1000
TM_MATCH_TIMEOUT_MS=60000
TM_ATTEMPT_TIMEOUT_MS=90000
TM_MEMORY_LIMIT_BYTES=268435456
TM_OUTPUT_LIMIT_BYTES=1048576
TM_MAX_RETRIES=3
TM_RETRY_DELAY_MS=1000
# Espera entre la parada suave de un intento Ray y la forzada.
TM_CANCEL_GRACE_MS=5000
# Descarga de bots en los workers (4.2). En Docker las fija start-cluster.sh:
# no guardes aquí el token; vacío desactiva la ruta interna del coordinador.
TM_ARTIFACT_URL=
TM_INTERNAL_TOKEN=
TM_ARTIFACT_DOWNLOAD_TIMEOUT_MS=10000
