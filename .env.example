# Los scripts Docker leen estas cinco opciones como texto; el entorno prevalece.
# Copia a .env y elige una contraseña de solo letras y números.
TM_POSTGRES_PASSWORD=
TM_POSTGRES_IMAGE=postgres:16.6-bookworm
TM_IMAGE=tournament-management:step-1.5
TM_API_PORT=8000
TM_START_TIMEOUT=180

# Opciones de la aplicación para ejecución local: hay que exportarlas manualmente.
TM_ROLE=coordinator
TM_BACKEND=local
TM_RAY_ADDRESS=auto
TM_HTTP_HOST=127.0.0.1
TM_HTTP_PORT=8000
TM_DATA_DIR=./data
# Vacío solo para diagnóstico local. En un coordinador desplegado debe apuntar a PostgreSQL.
TM_DATABASE_URL=
TM_LOG_LEVEL=INFO
# Límites validados; se aplicarán al implementar árbitro y scheduler.
TM_TURN_TIMEOUT_MS=1000
TM_MATCH_TIMEOUT_MS=60000
TM_ATTEMPT_TIMEOUT_MS=90000
TM_MEMORY_LIMIT_BYTES=268435456
TM_OUTPUT_LIMIT_BYTES=1048576
TM_MAX_RETRIES=3
TM_RETRY_DELAY_MS=1000
